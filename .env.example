# Bắt buộc khi chạy thật
DATABASE_URL=            # chuỗi kết nối Postgres (Neon, dạng pooled)
ADMIN_PASSWORD=          # mật khẩu trang /admin, từ 12 ký tự
SESSION_SECRET=          # chuỗi ngẫu nhiên từ 32 ký tự: openssl rand -base64 32

# Tài khoản khách (OTP)
OTP_MODE=demo            # demo = mã cố định 123456, sms = gửi SMS thật
SMS_API_KEY=             # chỉ cần khi OTP_MODE=sms

# Công khai (NEXT_PUBLIC_*), đều không bắt buộc
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OTP_DEMO=1
NEXT_PUBLIC_USE_MOCK=    # 1 = chạy giao diện bằng dữ liệu mẫu, không cần DB
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_MESSENGER_PAGE=
