# Bắt buộc cho API và quản trị thật; build không cần DATABASE_URL.
# Neon Postgres: dùng chuỗi pooled, có sslmode=require.
DATABASE_URL=
# Mật khẩu quản trị riêng, ít nhất 12 ký tự.
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên ít nhất 32 ký tự. Không đưa vào NEXT_PUBLIC_*.
SESSION_SECRET=

# demo: OTP cố định 123456, không gửi SMS. sms: cần tự gắn nhà cung cấp.
OTP_MODE=demo
SMS_API_KEY=

# Tùy chọn. Khi deploy điền URL HTTPS thật để có ảnh chia sẻ tuyệt đối.
NEXT_PUBLIC_SITE_URL=
# Chỉ hiện dòng gợi ý OTP khi =1, nên đặt cùng OTP_MODE=demo.
NEXT_PUBLIC_OTP_DEMO=1
# =1 để xem thử không có DB; để trống khi dùng API Postgres thật.
NEXT_PUBLIC_USE_MOCK=
# Bỏ trống thì không tải dịch vụ tương ứng. Chỉ tải sau đồng ý cookie.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
